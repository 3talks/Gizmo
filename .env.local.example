# Copy this file to ".env.local" and fill in the values from your
# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Anon / public key (Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# That's it — no service role key is needed. All admin writes run through
# the signed-in admin's own session and are protected by Row Level Security
# (see supabase/schema.sql).
